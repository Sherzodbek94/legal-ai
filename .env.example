# ---------------------------------------------------------------------------
# Database (packages/database, apps/api)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legaltech?schema=public"

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Gateway rate limiting (@nestjs/throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# Local only — the guard ignores this when NODE_ENV=production, so it can never
# switch off rate limiting on a real deployment. Set it when running the
# Playwright suite, which drives the dev server and otherwise 429s itself.
# THROTTLE_DISABLED=true

# ---------------------------------------------------------------------------
# Health, metrics, and shutdown (apps/api/src/modules/health)
# ---------------------------------------------------------------------------
# The API is mounted under /api. Probe and scrape paths are excluded from that
# prefix, because the kubelet and Prometheus reach the pod directly:
#
#   /health/live    liveness  — heap only. Deliberately does NOT check Postgres
#                               or Redis: failing it RESTARTS the pod, and a
#                               database blip would then restart every replica
#                               at once.
#   /health/ready   readiness — checks Postgres and Redis, and returns 503 the
#                               moment SIGTERM arrives so the pod drains.
#   /health         aggregate — both of the above; used by the Docker HEALTHCHECK.
#   /metrics        Prometheus exposition. NOT routed by the Ingress, so it is
#                               reachable only from inside the cluster.
#
# Seconds to keep reporting unready after SIGTERM before shutting down. Must stay
# well under the pod's terminationGracePeriodSeconds (90) and should match the
# preStop sleep (15). Defaults to 15 in production and 0 elsewhere — draining
# only matters behind a load balancer, and a 15s pause on every local restart is
# friction with no benefit.
SHUTDOWN_DRAIN_SECONDS=15

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
# MUST include the /api suffix: the NestJS app is mounted under a global `/api`
# prefix, and in production the Ingress routes /api to it on the same origin.
# Without the suffix every request from the web app 404s — the pages still
# render, so it looks like "all the panels are broken" rather than a config error.
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-strong-random-secret"
JWT_ISSUER="legaltech-api"
JWT_AUDIENCE="legaltech-web"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated allowlist; credentialed CORS cannot use "*".
CORS_ORIGINS="http://localhost:3000"

# The web app's public origin, no trailing slash. Used to build links inside
# emails and other notifications sent from the API (e.g. "your renewal is
# ready to pay" points here at /billing) — those are read outside a browser
# session, so a relative path has nothing to resolve against.
WEB_APP_URL="http://localhost:3000"

# How long a company invitation link stays valid.
INVITATION_TTL_DAYS=7

# ---------------------------------------------------------------------------
# Redis (OTP challenges, OneID CSRF state)
# ---------------------------------------------------------------------------
# On Windows, 6379 often falls inside a Hyper-V reserved TCP range and the
# container will refuse to bind. Check with:
#   netsh interface ipv4 show excludedportrange protocol=tcp
# If it is reserved, set REDIS_PORT to something outside every listed range
# (e.g. 16379) and change the port in REDIS_URL to match.
# REDIS_PORT=16379
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# SMS OTP
# ---------------------------------------------------------------------------
# Delivery is by DevSMS (see DEVSMS_* further down). Without a token a
# non-production build logs the code at `warn` so the flow stays testable; in
# production the same path refuses to issue a code it cannot deliver.
#
# A correct code IS the sign-in — the number is unique and proven by
# possession, so the API mints a session rather than stopping at "verified",
# and a first code to an unknown number creates the account.
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# ---------------------------------------------------------------------------
# OneID (id.egov.uz) — credentials are issued per client by the operator
# ---------------------------------------------------------------------------
#
# All three of CLIENT_ID, CLIENT_SECRET and REDIRECT_URI must be set for the
# button to appear at all — /auth/providers reports it unconfigured otherwise.
# A half-set OneID used to build an authorization URL with an empty client_id
# and only fail at the callback.
ONEID_BASE_URL="https://sso.egov.uz/sso/oauth/Authorization.do"
ONEID_CLIENT_ID=""
ONEID_CLIENT_SECRET=""
ONEID_REDIRECT_URI="http://localhost:4000/api/auth/oneid/callback"
ONEID_SCOPE="myportal"

# ---------------------------------------------------------------------------
# Google sign-in (OAuth 2.0 / OpenID Connect)
# ---------------------------------------------------------------------------
# From console.cloud.google.com → APIs & Services → Credentials → OAuth client
# ID (type: Web application). The redirect URI below must be listed there
# verbatim, including the port and the /api prefix, or Google refuses the
# exchange with redirect_uri_mismatch.
#
# Unset means the /auth/google routes answer 503 rather than half-working —
# the same fail-closed rule every other integration here follows.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# ---------------------------------------------------------------------------
# AI Engine
# ---------------------------------------------------------------------------
# Which provider is tried first; the other serves as the failover.
AI_PRIMARY_PROVIDER="anthropic"
AI_MAX_TOKENS=8192

# How long one generation may take before it is abandoned.
#
# Both SDKs default to a 10-minute timeout AND retry twice, so an unconfigured
# client can hold a request open for half an hour without reporting anything.
# Nothing downstream can act until it gives up: not the failover to the other
# provider, not the fallback to the plain interpolated template. A "Generating…"
# button that never resolves is this value being absent, not a crash.
AI_REQUEST_TIMEOUT_MS=120000
# Forwarded only to providers that accept sampling parameters (OpenAI).
# Current Claude models reject `temperature` with HTTP 400 — see
# AnthropicProvider, which uses ANTHROPIC_EFFORT instead.
AI_TEMPERATURE=0.2

ANTHROPIC_API_KEY="sk-ant-..."
# NOTE: claude-3-5-sonnet is retired and returns 404.
ANTHROPIC_MODEL="claude-sonnet-5"
ANTHROPIC_EFFORT="medium"

OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# ---------------------------------------------------------------------------
# Document storage (S3-compatible)
# ---------------------------------------------------------------------------
# Bucket MUST be private: seals and signatures are forgery-grade material and
# are served only through short-lived presigned URLs.
S3_BUCKET_NAME=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"
# Set only for MinIO/Ceph-style deployments; forces path-style addressing.
S3_ENDPOINT=""

# Max size for corporate seal / signature uploads (bytes).
COMPANY_ASSET_MAX_BYTES=5242880

# ---------------------------------------------------------------------------
# Notifications (apps/api/src/modules/notification)
# ---------------------------------------------------------------------------
# BullMQ shares REDIS_URL above. It takes its own connection rather than reusing
# the shared client, because BullMQ requires maxRetriesPerRequest: null and
# forcing that onto the shared client would change failure behaviour for every
# other Redis user in the process.

# --- DevSMS.uz SMS ----------------------------------------------------------
# A static bearer token issued from the DevSMS dashboard — no login call and no
# refresh, so nothing about it is cached or shared between replicas. This is the
# only credential the SMS channel needs; leave it empty outside production and
# codes are logged instead of sent.
DEVSMS_BASE_URL="https://devsms.uz/api"
DEVSMS_TOKEN=""
# Sender id for ordinary notifications. `4546` is DevSMS's default. Operators
# moderate message text, so unapproved wording sent through it may be accepted
# and never delivered — acceptable for notifications, not for sign-in codes,
# which go through the OTP templates below instead.
DEVSMS_FROM="4546"
# Which upstream gateway DevSMS routes through (e.g. "eskiz"). Empty means the
# account's own default, which is what most accounts want.
DEVSMS_TYPE=""
#
# --- OTP templates ---
# Sign-in codes use DevSMS's `universal_otp` mode, which borrows a template the
# operators have ALREADY approved. That is what lets a new account deliver codes
# immediately instead of waiting weeks for a template or a branded sender id.
# The wording is fixed; only the name and the code below are ours.
#
# 1 confirm an action · 2 reset a password · 3 register · 4 sign in
DEVSMS_OTP_TEMPLATE="4"
# Appears INSIDE the message, and is checked by DevSMS's AI moderation. 2-50
# characters. A name it rejects is charged for and not delivered, so keep it to
# a plain business name.
DEVSMS_SERVICE_NAME="LegalTech"
# NOTE: OTP_CODE_LENGTH above must stay within 4-8 — the approved templates
# accept nothing else, and the send is refused before it is attempted.

# --- Telegram ---------------------------------------------------------------
# From @BotFather. A bot cannot message a chat that has not messaged it first,
# so users link their account via /notifications/telegram/link.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# --- Email ------------------------------------------------------------------
# Resend wins when both are set: an operator who configured a Resend key has
# opted into the managed path, and silently preferring leftover SMTP settings
# would send from an address they no longer monitor.
RESEND_API_KEY=""

# SMTP, for self-hosted or data-residency-constrained deployments. `secure` is
# derived from the port (implicit TLS on 465, STARTTLS elsewhere) rather than
# being a separate setting to get wrong.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_MAX_CONNECTIONS=5

EMAIL_FROM="LegalTech <no-reply@localhost>"

# ---------------------------------------------------------------------------
# OCR and search (apps/api/src/modules/ocr-search)
# ---------------------------------------------------------------------------
# Embedding model. MUST produce 1536 dimensions — `document_chunks.embedding`
# and `template_embeddings.embedding` are vector(1536) columns and a mismatch
# fails every insert. Changing this requires a migration and a full re-embed.
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Concurrent Tesseract WASM workers. Each holds several hundred MB resident, so
# requests beyond this are shed rather than queued — an unbounded queue turns a
# burst of uploads into an OOM kill.
OCR_MAX_CONCURRENT=2

# Documents per poll, and how many times one may fail before it stops being
# picked up.
OCR_BATCH_SIZE=3
OCR_MAX_ATTEMPTS=3

# Where tesseract.js caches downloaded traineddata. Set to a persistent volume
# in production — otherwise every container restart re-downloads tens of
# megabytes of language models before the first document can be read.
OCR_CACHE_PATH=""

# NOTE ON SCANNED PDFs: tesseract.js reads images, not PDFs. PDFs carrying a
# text layer are extracted directly (exact, and cheaper than re-recognising
# them). PDFs that are pure scans need rasterising first, which requires
# poppler-utils (pdftoppm) in the API image. Without it those uploads fail with
# an explicit message rather than indexing as blank.

# ---------------------------------------------------------------------------
# Billing (apps/api/src/modules/billing)
# ---------------------------------------------------------------------------
# Days of continued service after a renewal charge fails. A failed card is
# usually an expired card; cutting service instantly turns a billing hiccup
# into a churn event. Grace starts at the first failure and is not extended by
# retries.
BILLING_GRACE_PERIOD_DAYS=7

# Consecutive failed renewals before the subscription drops to UNPAID.
BILLING_MAX_RENEWAL_ATTEMPTS=4

# Subscriptions processed per hourly renewal pass, bounding a single run.
BILLING_RENEWAL_BATCH_SIZE=200

# Days of closed usage windows to retain before the nightly prune. Enforcement
# only ever reads the current period; this is purely for support lookups.
BILLING_USAGE_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Payment gateways (apps/api/src/modules/payment)
# ---------------------------------------------------------------------------
# How long a customer has to complete a checkout. Kept UNDER Payme's own
# 12-hour transaction timeout so an order can never outlive the gateway
# transaction pointing at it.
PAYMENT_ORDER_TTL_MS=21600000

# --- CLICK (SHOP-API) -------------------------------------------------------
# Issued in the CLICK merchant cabinet. The secret key is the ONLY thing
# authenticating a payment confirmation — an empty value makes the handler
# reject every callback rather than accept unsigned ones.
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""

# --- Payme (Merchant API) ---------------------------------------------------
# Payme authenticates as Basic "Paycom:<key>". The login is fixed by the
# protocol, so the key is the whole secret.
PAYME_MERCHANT_ID=""
PAYME_MERCHANT_KEY=""
# Field inside the JSON-RPC `account` object carrying our order id. Agreed per
# merchant with Payme; `order_id` is the usual default.
PAYME_ACCOUNT_FIELD="order_id"

# --- Uzum Bank --------------------------------------------------------------
# NOTE: Uzum issues its integration contract per merchant. The signature base
# string in UzumService is the documented checkout shape and MUST be
# reconciled against the contract issued for this merchant before go-live.
UZUM_MERCHANT_ID=""
UZUM_SECRET_KEY=""

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=""
# From the Stripe dashboard's webhook endpoint. Signature verification needs
# the raw request body — see `rawBody: true` in main.ts.
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Document generation (apps/api/src/modules/document)
# ---------------------------------------------------------------------------
# HMAC key for the verification code printed on every exported document.
# Forging this forges proof of issuance — generate with:
#   openssl rand -base64 48
# Minimum 32 characters; the service refuses anything shorter.
DOCUMENT_VERIFICATION_SECRET="replace-with-a-strong-random-secret"

# Public base URL the printed QR code resolves to. Must be reachable by people
# who are not users of the platform (bank clerks, counterparty counsel).
DOCUMENT_VERIFICATION_BASE_URL="http://localhost:3000/verify"

# Seconds before a verification link stops resolving. 0 = never expires, which
# is the right default: a contract stays verifiable for as long as it binds.
DOCUMENT_VERIFICATION_MAX_AGE_SECONDS=0

# --- PDF rendering (Puppeteer) ---------------------------------------------
# Concurrent Chromium pages. Exceeding this sheds load rather than queueing:
# Chromium under memory pressure takes the whole process down.
PDF_MAX_CONCURRENT_PAGES=4
PDF_RENDER_TIMEOUT_MS=30000
PDF_LAUNCH_TIMEOUT_MS=30000

# Set only if you ship your own Chromium instead of the bundled build.
PUPPETEER_EXECUTABLE_PATH=""

# Disables the Chromium sandbox. Document content is AI-generated from
# user-supplied values and is rendered in a real browser, so leave this false
# and run the container as a non-root user with the sandbox intact.
PUPPETEER_NO_SANDBOX=false

# ---------------------------------------------------------------------------
# iHamkor — counterparty (business registry) lookup
# ---------------------------------------------------------------------------
# Fills the other party's registered details on a contract from the state
# register, so a drafter is not retyping a STIR out of a scan and the AI is not
# asked for a number it is forbidden to invent.
#
# iHamkor is operated by DEFEN FINANCIAL LLC under a public-private partnership
# contract (DXSh/52-2022) pursuant to Cabinet of Ministers Resolution No. 529 of
# 19 August 2021 — the instrument that permits taxpayer data to be released to
# third parties. Credentials are issued per client; they also run a startup
# programme with free API access.
#
# Deliberately NOT orginfo.uz: that is one developer's scrape of stat.uz open
# data with no API, and the Statistics Committee filed a complaint against its
# founder in December 2021.
#
# Unset means the lookup field is not offered at all. Bank details (MFO,
# settlement account) are never returned — they are not in the public register.
IHAMKOR_BASE_URL="https://api.ihamkor.uz"
IHAMKOR_API_KEY=""

# ---------------------------------------------------------------------------
# Legislation corpus
# ---------------------------------------------------------------------------
# The retrieval half of "answers grounded in Uzbek law". `document_chunks`
# indexes each tenant's own scans; this indexes the statute book itself, shared
# by every tenant and cited by article rather than quoted.
#
# A directory of acts, one per .txt/.md file, with optional front matter:
#
#     ---
#     externalId: -111181
#     title: O'zbekiston Respublikasi Fuqarolik kodeksi
#     type: CODE
#     language: uz-Latn
#     status: IN_FORCE
#     url: https://lex.uz/docs/-111181
#     ---
#     346-modda. ...
#
# WHY A DIRECTORY AND NOT A lex.uz SCRAPER: lex.uz is the sole official
# publisher of Uzbek legislation, documents no API, publishes no terms of use at
# a stable URL, and is operated by a state institution ("Adolat" centre, under
# the Ministry of Justice). This repository therefore ships no scraper for it.
# Point this at whatever text has been lawfully obtained — a bulk export agreed
# with the centre, an open-data set, or files downloaded by hand. A lex.uz
# adapter is one class implementing `LegalCorpusSource`; nothing above it
# changes when it arrives.
#
# Unset means the corpus feature reports itself unconfigured and ingests
# nothing. Build it with: POST /api/legal-corpus/ingest (SUPER_ADMIN only).
#
# `data/legal-corpus/` is set up for this and carries a README with the format,
# the ingest call, and the rule about where the text may come from. It is empty
# of acts on purpose: legislative text arrives under someone else's terms, and a
# git history is a redistribution — so the directory is committed and its
# contents are not.
LEGAL_CORPUS_DIR="./data/legal-corpus"

# ---------------------------------------------------------------------------
# PII redaction before AI calls
# ---------------------------------------------------------------------------
# Document prompts carry whatever the template variables held — routinely a
# counterparty's settlement account, a director's passport number, a client's
# phone. None of it changes how the model drafts a clause, so it is replaced
# with placeholders ([STIR_1], [BANK_ACCOUNT_1], ...) before the request leaves
# this process, and the real values are restored into the answer.
#
# On unless set to exactly "false". A deployment that genuinely needs the model
# to see raw identifiers has to say so; one that wants them protected should not
# have to remember to ask.
AI_REDACT_PII=true
