# ---------------------------------------------------------------------------
# Database (packages/database, apps/api)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legaltech?schema=public"

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Gateway rate limiting (@nestjs/throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-strong-random-secret"
JWT_ISSUER="legaltech-api"
JWT_AUDIENCE="legaltech-web"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Comma-separated allowlist; credentialed CORS cannot use "*".
CORS_ORIGINS="http://localhost:3000"

# ---------------------------------------------------------------------------
# Redis (OTP challenges, OneID CSRF state)
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# SMS OTP
# ---------------------------------------------------------------------------
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# ---------------------------------------------------------------------------
# OneID (id.egov.uz) — credentials are issued per client by the operator
# ---------------------------------------------------------------------------
ONEID_BASE_URL="https://sso.egov.uz/sso/oauth/Authorization.do"
ONEID_CLIENT_ID=""
ONEID_CLIENT_SECRET=""
ONEID_REDIRECT_URI="http://localhost:4000/auth/oneid/callback"
ONEID_SCOPE="myportal"

# ---------------------------------------------------------------------------
# AI Provider
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."

# ---------------------------------------------------------------------------
# Document storage (S3-compatible)
# ---------------------------------------------------------------------------
# Bucket MUST be private: seals and signatures are forgery-grade material and
# are served only through short-lived presigned URLs.
S3_BUCKET_NAME=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"
# Set only for MinIO/Ceph-style deployments; forces path-style addressing.
S3_ENDPOINT=""

# Max size for corporate seal / signature uploads (bytes).
COMPANY_ASSET_MAX_BYTES=5242880
