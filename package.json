{
  "name": "legaltech-saas",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "turbo run db:generate",
    "db:push": "npm run db:push --workspace=@legaltech/database",
    "db:migrate": "npm run db:migrate --workspace=@legaltech/database",
    "db:studio": "npm run db:studio --workspace=@legaltech/database"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "npm@11.12.1"
}
